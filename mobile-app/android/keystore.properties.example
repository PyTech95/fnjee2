# Copy this file to "keystore.properties" (same folder) and fill it in.
# keystore.properties and the .jks file must NEVER go to GitHub (both are in .gitignore).
#
# storeFile: path to the upload key, relative to this android folder or absolute.
#            Windows: use forward slashes, e.g. C:/FNJEE-keys/fnjee-upload.jks
storeFile=fnjee-upload.jks
storePassword=PASTE_STORE_PASSWORD
keyAlias=fnjee
keyPassword=PASTE_KEY_PASSWORD
